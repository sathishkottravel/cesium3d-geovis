{
  "name": "cesium3d-geovis",
  "productName": "Cesium3D GeoVis",
  "version": "0.1.0",
  "description": "Geospatial visualization with CesiumJS/Resium — web (GitHub Pages) and Electron runtimes",
  "private": true,
  "main": ".vite/build/main.js",
  "author": "SatKo",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:wasm": "vitest run --project wasm",
    "test:coverage": "vitest run --coverage",
    "electron:start": "electron-forge start",
    "electron:package": "electron-forge package",
    "electron:make": "electron-forge make"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "cesium": "^1.145.0",
    "graphql-ws": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "resium": "^1.26.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^44.4.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.2"
  }
}
