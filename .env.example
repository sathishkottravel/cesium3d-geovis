# Transport: standalone | standalone_remote | msfs | api   (default: standalone)
VITE_TRANSPORT=standalone
# Base URL of the HTTP backend (used when VITE_TRANSPORT=api or standalone_remote)
VITE_API_BASE_URL=http://localhost:3000/api/mock
# Optional Cesium ion access token (terrain / imagery)
VITE_CESIUM_ION_TOKEN=
# Public base path for the web build (GitHub Pages project site: /cesium3d-geovis/)
VITE_BASE=/
# Telemetry GraphQL endpoint (default: /telemetry-api/graphql via the dev proxy in `vite` dev,
# https://aviation-api-5f6p.onrender.com/graphql in builds)
VITE_TELEMETRY_GRAPHQL_URL=
# Initial telemetry data source: api | sample (offline sample traffic, no token needed).
# Default: api in `bun run dev`, sample in builds (GitHub Pages, desktop app). Users can switch in the page.
VITE_TELEMETRY_SOURCE=
# Comma-separated health URLs pinged (no auth) when the telemetry page opens, to start their cold start early
VITE_TELEMETRY_WAKE_URLS=https://aviation-producer.onrender.com/health,https://aviation-worker.onrender.com/health,https://aviation-api-5f6p.onrender.com/health
# Backend the dev proxy (/telemetry-api) forwards to, e.g. http://localhost:8000 for a local API
# (default: https://aviation-api-5f6p.onrender.com). No VITE_ prefix: used by the dev server only.
TELEMETRY_API_ORIGIN=
# Telemetry API token for the dev proxy ONLY. No VITE_ prefix on purpose: the proxy adds it
# server-side, so it never reaches browser code or a build. Web/Electron users paste it in the panel.
TELEMETRY_API_TOKEN=
